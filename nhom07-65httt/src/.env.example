# Copy to .env at the workspace root. Replace every CHANGE_ME value.
# Docker Compose uses the DB_* and MINIO_ROOT_* values to start local services.
DB_USER=learning_hub
DB_PASSWORD=CHANGE_ME_database_password
DB_NAME=learning_hub
# Optional host ports for Docker Compose. Container-to-container ports stay unchanged.
# Set these only when the default ports are already in use on your computer.
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000
# WEB_HOST_PORT=3000
MINIO_ROOT_USER=CHANGE_ME_storage_user
MINIO_ROOT_PASSWORD=CHANGE_ME_storage_password
SECRET_KEY=CHANGE_ME_generate_at_least_32_random_characters
AI_KEY_ENCRYPTION_KEY=CHANGE_ME_generate_32_random_bytes_as_hex
INTERNAL_API_KEY=CHANGE_ME_generate_at_least_16_random_characters

# Native processes use the same file. Keep credentials in DATABASE_URL and
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY aligned with the values above for local infra.
DEBUG=true
DATABASE_URL=postgresql+asyncpg://learning_hub:CHANGE_ME_database_password@localhost:5432/learning_hub
DB_SSL_MODE=disable
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_storage_user
MINIO_SECRET_KEY=CHANGE_ME_storage_password
MINIO_BUCKET_NAME=documents-bucket
MINIO_SECURE=false
AI_SERVICE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

# External providers are optional until their features are used.
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
VNPAY_MERCHANT_ID=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Next.js reads NEXT_PUBLIC_* values from this shared .env file.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
INTERNAL_API_URL=http://localhost:8000
